{
  "account": {
    "primary_google_account": "your-primary@gmail.com",
    "secondary_google_account": "your-secondary@gmail.com",
    "work_cloud_label": "",
    "device_serial": "auto",
    "device_model_hint": "Pixel 4",
    "rclone_primary_remote": "gdrive_primary",
    "rclone_secondary_remote": "gdrive_secondary",
    "nas_host": "",
    "nas_share_path": ""
  },
  "sources": [
    {
      "name": "Mac 本機照片 (Mac Pictures)",
      "type": "mac_folder",
      "path": "~/Pictures/ToGooglePhotos",
      "enabled": true
    },
    {
      "name": "iPhone 匯入資料夾 (iPhone Import)",
      "type": "iphone_import",
      "path": "~/Pictures/iPhone_Import",
      "enabled": true
    },
    {
      "name": "Google Drive 掛載 / 下載區",
      "type": "google_drive",
      "path": "~/GoogleDrive_Relay",
      "enabled": true
    },
    {
      "name": "外接硬碟 / NAS (External Drive)",
      "type": "external_drive",
      "path": "/Volumes",
      "enabled": false
    }
  ],
  "scope": {
    "date_from": "",
    "date_to": "",
    "include_photos": true,
    "include_videos": true,
    "include_raw": false,
    "exclude_patterns": [
      ".DS_Store",
      "Thumbs.db",
      "@eaDir",
      ".Trash",
      "Thumbnails"
    ],
    "batch_size_gb": 15.0,
    "min_free_gb": 12.0,
    "delete_source_after_push": false,
    "default_browse_path": "~"
  }
}
